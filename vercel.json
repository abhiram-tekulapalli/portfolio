{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...all].ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/health",
      "dest": "/api/[...all]"
    },
    {
      "src": "/resume.pdf",
      "dest": "/api/[...all]"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...all]"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
