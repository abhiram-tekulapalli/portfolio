# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Authentication
JWT_SECRET="your-jwt-secret-key"
ADMIN_PASSWORD="your-secure-password"

# APP_URL: The URL where this application is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://your-frontend-url.vercel.app"

# MongoDB Atlas configuration (REQUIRED for Vercel production)
# Create a free database at mongodb.com and copy the connection string here
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"
# MONGODB_DB_NAME="portfolio_db"
# MONGODB_COLLECTION_NAME="portfolio_data"

# Frontend development configuration
VITE_API_BASE_URL="" # Leave empty for Vercel (uses same-origin /api/*)
BACKEND_URL="https://portfolio-rty5.onrender.com" # Optional: only for Render fallback or local testing
FRONTEND_URL="https://your-frontend-url.vercel.app"
